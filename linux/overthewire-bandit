3. echo "Hello" > file.txt : Creates a file and writes text into it. If the file already exists, then it replaces existing file content.
4. echo "Hello" >> file.txt : Adds text to the end of an existing file without replacing existing content.
5. nano notes.txt : Opens the Nano text editor (a terminal-based text editor for creating, opening, editing and saving text files directly from the terminal) and creates notes.txt file if it doesn't exist. If the file already exists, Nano opens it.
			- Ctrl + O : Save a file
			- Ctrl + X : Exit the Nano editor
6. rm file.txt : Deletes a file
7. rmdir foldername : Deletes an empty directory
8. rm -r foldername : Deletes a directory and its contents
9. rm -f file.txt : Force-deletes a file without asking for confirmation
10. rm -rf foldername : Force-deletes a directory and everything inside it
11. mv oldname.txt newname.txt : Renames a file
12. mv old-folder new-folder : Renames a directory
13. mv file.txt foldername/ : Moves a file into a directory
14. mv folder1 folder2/ : Moves a directory inside another directory
15. cp file1.txt file2.txt : Copies a file
16. cp file.txt foldername/ : Copies a file into a directory
17. cp -r folder1 folder2 : Copies a directory and its contents
18. pwd : Displays your current directory location
19. ls : Lists files and directories
20. ls -l : Displays files in a detailed list. Lets you inspect file permissions
21. ls -a : Displays hidden files too
22. ls -la : Displays all files, including hidden files, in detailed format
23. cd foldername : Enters a directory
24. cd ~ : Goes to your home directory
25. cd / : Goes to the root directory
26. clear : Clears the terminal screen
27. exit : Exits the current shell or remote session
28. grep : Search for a specific word, phrase or pattern in text
29. grep "word" filename : Finds lines containing 'word'
30. grep -i "word" filename : Searches without considering uppercase/lowercase differences
31. grep -n "word" filename : Displays matching lines with their line numbers
32. grep -v "word" filename : Displays lines that do NOT contain 'word'
33. grep -c "word" filename : Counts the number of matching lines
34. grep -r "word" foldername/ : Searches for 'word' inside files in a directory.
35. grep -w "word" filename : Searches for 'word' as a complete word
36. find . -name "notes.txt" : Searches for a file named notes.txt starting from the current directory
37. . (symbol) : Current directory
38. .. (symbol) : Parent directory
39. ~ (symbol) : Your home directory
40. / (symbol) : Root directory or a path separator, depending on where it appears
41. | (symbol) : Pipe symbol. Take the output of one command and pass it as the input to another command
42. > (symbol) : Sends output into a file, replacing its existing content
43. >> (symbol) : Adds output to the end of a file without replacing its existing content
44. & (symbol) : Runs a command in the background when used at the end
45. ; (symbol) : Runs multiple commands sequentially
46. cat file.txt : Displays file contents
47. head file.txt : Displays the first 10 lines
48. tail file.txt : Displays the last 10 lines
49. wc -l file.txt : Counts the number of lines
50. diff file1 file2 : Shows differences between two files
51. chmod +x script.sh : Adds permission to execute a file
52. chmod 644 file.txt : Sets specific read/write permissions
53. chmod 600 file.txt : Gives the owner read/write permission and removes permissions for others. If file.txt is a keyfile then it restricts access to a private key file.
54. Permission Numbers :- First Number - Owner permissions ; Second Number - Group permissions ; Third Number - Permissions for Others
				-> 4 - Read ; 2 - Write ; 1 - Execute ; 7 - Read + Write + Execute ; 6 - Read + Write ; 5 - Read + Execute ; 0 - No permissions
55. ssh username@hostname -p 2220 : Connects to a remote server using SSH
56. ssh -i keyfile username@hostname -p 2220 : Connects using a private key
57. scp -P 2220 source destination : Copies files between computers using SSH
58. git clone URL : Downloads a copy of a Git repository
59. git status : Shows the current state of your repository
60. git branch -a : Lists local and remote-tracking branches
61. git checkout dev : Switches to the dev branch
62. git log : Displays commit history
63. git show COMMIT:filename : Displays information about a commit
64. git tag : Lists available tags
65. git show secret : Displays information associated with the secret tag
66. git add file.txt : Prepares to add a file (a change is initiated) for a commit
67. git add -f file.txt : Force-adds an ignored file
68. git commit -m "message" : Saves changes as a commit
69. git push origin master : Sends commits to the remote master branch
70. whoami : Displays the current username
71. file filename : Identifies the type of a file
72. man command : Opens the manual/help page for a command
73. echo $0 : Displays the name of the current shell or script
74. file ./* : Identify the type of every file in the current directory
75. find . -size 1033c -type f ! -executable : Search for files using size, type and permission conditions
76. find / -type f -user bandit7 -group bandit6 -size 33c : Search the filesystem using ownership and size conditions
77. sort : Arrange lines in order
78. uniq -u : Display lines that occur exactly once in consecutive input. Input should be sorted first when checking duplicates across a whole file.
79. strings : Extract readable text from binary data
80. base64 -d : Decode Base64-encoded data
81. tr : Translate or replace characters
82. mktemp -d : Create a temporary directory
83. cd $(mktemp -d) : Create a temporary directory and immediately enter it
84. cp ~/data.txt . : Copy a file from the home directory into the current directory
85. xxd -r : Convert a hexdump back into its original binary data
86. gunzip : Decompress gzip files
87. bunzip2 : Decompress bzip2 files
88. tar -xf : Extract a tar archive
89. nc : Connect to a network service using Netcat
90. openssl s_client -connect localhost:PORT : Connect to a service using SSL/TLS
91. nmap -p : Scan specified network ports
92. nc -l -p : Start a Netcat listener on a specified port
93. ./suconnect : Run the suconnect program from the current directory
94. md5sum : Generate an MD5 hash
95. 'for' loop : Repeat commands for a range of values
96. 'do' and 'done' : Mark the beginning and end of a shell loop
97. $i : Access the current value of the loop variable
98. v : Open and work with the vi text editor. It is a shortcut used inside 'more', not a standalone Linux command.
99. :e filename : Open another file from inside vi
100. :set shell=/bin/bash : Set the shell that vi uses
101. :shell : Open a shell from inside vi
102. $0: $0 executes the shell name stored in that variable by itself

